# AgriTrace Backend Gateway Configuration

# Host and Port
HOST=127.0.0.1
PORT=5000
ENVIRONMENT=development

# Firebase Project Configuration
FIREBASE_PROJECT_ID=agritrace-ab141
# Path to service account credentials JSON file (optional if using Application Default Credentials)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Phase 4 Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=agritrace
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000
AUTO_MIGRATE_ON_STARTUP=true
PERSISTENCE_MODE=mongodb
ALLOW_STORE_FALLBACK=false
