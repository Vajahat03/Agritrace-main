# Copy to .env and set deployment-specific values. Never commit secrets.
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
AUTH_TOKEN_PEPPER=replace-with-a-long-random-secret
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:[DB_PASSWORD]@[SESSION-POOLER-HOST]:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
SUPABASE_STORAGE_BUCKET=agritrace-scans

# No real market provider is configured yet. The safe default is unavailable;
# set this TTL when injecting/configuring a real provider in a deployment.
MARKET_DATA_PROVIDER=none
MARKET_DATA_CACHE_TTL_SECONDS=900
